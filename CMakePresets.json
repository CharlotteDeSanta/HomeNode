{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "DebugKitchen",
            "inherits": "Debug",
            "cacheVariables": {
                "HOME_NODE_ROLE": "kitchen"
            }
        },
        {
            "name": "DebugLiving",
            "inherits": "Debug",
            "cacheVariables": {
                "HOME_NODE_ROLE": "living"
            }
        },
        {
            "name": "DebugBedroom",
            "inherits": "Debug",
            "cacheVariables": {
                "HOME_NODE_ROLE": "bedroom"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "DebugKitchen",
            "configurePreset": "DebugKitchen"
        },
        {
            "name": "DebugLiving",
            "configurePreset": "DebugLiving"
        },
        {
            "name": "DebugBedroom",
            "configurePreset": "DebugBedroom"
        }
    ]
}
